---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { partidos, eleccion, url, propuestasDe } from '../lib/data';
const fecha = new Date(eleccion.fecha + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Partidos">
  <h1 class="text-3xl font-bold">Elecciones generales: {fecha}</h1>
  <p class="mt-2 max-w-2xl text-muted">
    Qué propone cada partido, por temas y con enlace a la fuente. Orden alfabético.
    {!eleccion.verificado && <span> Fecha y candidaturas pendientes de verificar en fuentes oficiales.</span>}
  </p>
  <p class="mt-4"><a class="underline" href={url('comparador/')}>Comparar partidos</a> · <a class="underline" href={url('buscar/')}>Buscar propuestas</a></p>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {partidos.map((p) => (
      <li class="relative overflow-hidden rounded-lg border border-line bg-surface p-5">
        <span class="absolute inset-x-0 top-0 h-1.5" style={`background:${p.color}`} aria-hidden="true"></span>
        <div class="flex items-center gap-4">
          <Logo siglas={p.siglas} color={p.color} />
          <div>
            <h2 class="text-lg font-semibold"><a class="hover:underline" href={url(`partido/${p.id}/`)}>{p.nombre}</a></h2>
            <p class="text-sm text-muted">Candidato/a: {p.candidato.nombre}{!p.candidato.verificado && ' (sin verificar)'}</p>
          </div>
        </div>
        <p class="mt-4 text-sm text-muted">{propuestasDe(p.id).length} propuestas cargadas</p>
        <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
          <a class="underline" href={url(`partido/${p.id}/`)}>Ver propuestas</a>
          {p.programa.url
            ? <a class="underline" href={p.programa.url} rel="noopener noreferrer" target="_blank">Programa completo</a>
            : <span class="text-muted">Programa: enlace pendiente</span>}
        </p>
      </li>
    ))}
  </ul>
</Base>
