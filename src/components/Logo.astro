---
// Monograma con las siglas. Los logotipos oficiales son marcas registradas; si se añaden,
// deben proceder de la web oficial del partido y citarse.
const { siglas, color, size = 56 } = Astro.props as { siglas: string; color: string; size?: number };
---
<span aria-hidden="true" class="inline-flex shrink-0 items-center justify-center rounded-md border-2 bg-surface text-[0.7rem] overflow-hidden font-extrabold tracking-tight"
  style={`width:${size}px;height:${size}px;border-color:${color}`}><span style={`font-size:${siglas.length > 5 ? 0.5 : 0.7}rem`}>{siglas}</span></span>
